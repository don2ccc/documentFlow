# ============================================================
#  DocumentFlow 环境变量样例
#
#  本地开发：复刻为 apps/server/.env，按本机连接串填写
#  生产部署：复刻为仓库根目录的 .env，由 systemd EnvironmentFile 加载
#            （/etc/systemd/system/documentflow-api.service）
#
#  真实 .env 含数据库密码与 JWT 密钥，已被 .gitignore 排除，不要提交。
# ============================================================


# ---------- 运行环境 ----------

# production | development
NODE_ENV=production

# TypeORM 自动同步表结构。
#
# 注意 app.module.ts:35 的判断是
#     synchronize: NODE_ENV !== 'production' || DB_SYNC === 'true'
# 只要 NODE_ENV 不是 production，synchronize 就恒为 true，
# 开发环境下设 false 也关不掉。
#
# synchronize 会直接按实体定义改库结构，绕过 migrations/。
# 生产首次建表可临时设 true，建完务必改回 false 并重启，
# 之后所有结构变更走 migrations/ 下的 SQL。
DB_SYNC=false

# ---------- 服务 ----------

PORT=3000


# ---------- 数据库 ----------

DATABASE_URL=postgres://documentflow:password@localhost:5432/documentflow

# 集成测试用的独立库。不要指向生产库：
# 测试会建表、删表、造数据。
TEST_DATABASE_URL=postgres://documentflow:password@localhost:5432/documentflow_test


# ---------- 安全 ----------

# 生产必须替换。生成方式：openssl rand -hex 32
# 留空会退回开发默认值 dev-secret-change-me。
JWT_SECRET=change-me


# ---------- 外部访问地址 ----------

# 审批通知邮件里的链接由它拼出：
#   ${PUBLIC_BASE_URL}/applications/<id>
#   ${PUBLIC_BASE_URL}/documents/<id>
# 不设置时退回 https://localhost:8443，收件人点开就是打不开的地址。
# 实际取值以「系统设置」页面存进数据库的 public.baseUrl 为准，
# 数据库没配才回落到本项。
PUBLIC_BASE_URL=http://localhost


# ---------- 文件存储 ----------

UPLOAD_DIR=./data/documents
PREVIEW_DIR=./data/previews

# HR 员工照片。与文档上传同一个模式，存本地不走 FTP。
HR_PHOTO_DIR=./data/hr-photos

# 签名图片（手写签名板导出的 png）。
SIGNATURE_DIR=/opt/documentflow/uploads/signatures


# ---------- SMTP（可选）----------

# 这几项只是兜底。实际以「系统设置」页面存进数据库的值为准
# （smtp.host / smtp.port / smtp.secure / smtp.user / smtp.pass / smtp.from），
# 数据库没配才回落到这里。系统设置优先，便于运行时改，不用重启。
#
# configured = host && user && pass 三者齐备才算启用，
# 缺任意一个，所有邮件都会被跳过，只在日志里留一行 [mail-disabled]。
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# 留空时取 SMTP_USER，再留空则用 no-reply@example.com
SMTP_FROM=
