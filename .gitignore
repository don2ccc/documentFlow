node_modules/
dist/
build/
.env
.env.*
!.env.example
*.log
uploads/
data/
# 备份导出包：里面有员工照片、身份证号、工资、数据库口令。
# 这类东西绝不能进版本库，即使仓库是私有的也不行 —— 历史一旦提交就很难彻底抹掉。
backup-export/
dist-backup-*/
.DS_Store
Thumbs.db
.worktrees/

# 手工备份残留。
# 注意：原先只写了 `*.bak.*`（要求 .bak 后面还有点号和内容），
# 漏掉了实际存在的 applications.controller.ts.bak、AppLayout.tsx.bak2
# 等形态，导致这些文件一路被提交进仓库。
*.bak
*.bak[0-9]*
*.bak.*
*.orig
*.rej
*.new

# 运行时备份输出（含 database dump 与部署 tar.gz，不要入库）
backups/
*.tsbuildinfo
*.ssl.new
dist-backup-*/